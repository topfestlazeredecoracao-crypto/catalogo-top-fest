# Arquivo SECRETO: fica só neste computador (nunca vai para o GitHub).
# Cole cada valor depois do sinal de igual, sem espaços e sem aspas.

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (começa com sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys > Secret key (começa com sb_secret_)
# Usada só aqui no computador para importar o catálogo. NUNCA compartilhe.
SUPABASE_SECRET_KEY=
